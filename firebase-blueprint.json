{
  "entities": {
    "User": {
      "title": "User",
      "description": "A registered user of the ClickAds platform.",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "The user's chosen username."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "createdAt": {
          "type": "timestamp",
          "description": "When the user registered."
        },
        "welcomeBonus": {
          "type": "number"
        },
        "totalEarnings": {
          "type": "number"
        },
        "balance": {
          "type": "number"
        },
        "activationStatus": {
          "type": "string",
          "enum": ["none", "pending", "approved", "rejected"],
          "default": "none"
        },
        "password": {
          "type": "string",
          "description": "User password cached for admin management."
        }
      },
      "required": ["username", "email", "createdAt"]
    },
    "Activation": {
      "title": "Activation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "receiptImage": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["userId", "username", "receiptImage", "status", "createdAt"]
    },
    "Ad": {
      "title": "Ad",
      "description": "An advertisement link that users can click to earn rewards.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the ad."
        },
        "url": {
          "type": "string",
          "description": "The destination URL of the ad."
        },
        "rewardAmount": {
          "type": "number",
          "description": "The amount earned by clicking this ad."
        },
        "createdAt": {
          "type": "timestamp",
          "description": "When the ad was created."
        }
      },
      "required": ["title", "url", "rewardAmount", "createdAt"]
    },
    "Click": {
      "title": "Click",
      "description": "A record of a user clicking an ad.",
      "type": "object",
      "properties": {
        "adId": {
          "type": "string"
        },
        "rewardAmount": {
          "type": "number"
        },
        "clickedAt": {
          "type": "timestamp"
        },
        "cycle": {
          "type": "number"
        }
      },
      "required": ["adId", "rewardAmount", "clickedAt"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "amount": { "type": "number" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["userId", "username", "amount", "bankName", "accountNumber", "accountName", "status", "createdAt"]
    },
    "CheckIn": {
      "title": "CheckIn",
      "type": "object",
      "properties": {
        "rewardAmount": { "type": "number" },
        "checkedAt": { "type": "timestamp" },
        "date": { "type": "string" }
      },
      "required": ["rewardAmount", "checkedAt", "date"]
    },
    "Achievement": {
      "title": "Achievement",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "rewardAmount": { "type": "number" },
        "awardedAt": { "type": "timestamp" }
      },
      "required": ["type", "title", "rewardAmount", "awardedAt"]
    },
    "Activity": {
      "title": "Activity",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "type": { "type": "string", "enum": ["withdrawal", "achievement", "click", "checkin"] },
        "amount": { "type": "number" },
        "title": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["userId", "username", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and balances."
    },
    "/ads/{adId}": {
      "schema": { "$ref": "#/entities/Ad" },
      "description": "Stores available ads."
    },
    "/users/{userId}/clicks/{clickId}": {
      "schema": { "$ref": "#/entities/Click" },
      "description": "Stores records of ads clicked by the user."
    },
    "/users/{userId}/checkins/{checkinId}": {
      "schema": { "$ref": "#/entities/CheckIn" },
      "description": "Stores daily check-in records."
    },
    "/users/{userId}/achievements/{achievementId}": {
      "schema": { "$ref": "#/entities/Achievement" },
      "description": "Stores user achievements."
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/Withdrawal" },
      "description": "Stores withdrawal requests."
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "Stores global platform activities."
    },
    "/activations/{activationId}": {
      "schema": { "$ref": "#/entities/Activation" },
      "description": "Stores withdrawal activation requests."
    }
  }
}
